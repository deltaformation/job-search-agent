# Target local tracker configuration (implemented beginning in milestone R1).
# Copy to .env only after the corresponding runtime exists.

NODE_ENV=development
JOB_TRACKER_HOST=127.0.0.1
JOB_TRACKER_PORT=3000
JOB_TRACKER_TIMEZONE=America/Toronto

# Keep the rebuild isolated from the legacy Python/PostgreSQL artifact tree.
JOB_TRACKER_DATA_ROOT=./data/rebuild

# Provider configuration is optional: the app must still boot and show
# PROFILE_SETUP_REQUIRED or PROVIDER_NOT_CONFIGURED states without it.
# Supply an executable path plus a JSON argv array; never a shell command.
JOB_TRACKER_AGENT_EXECUTABLE=
JOB_TRACKER_AGENT_ARGS_JSON=[]

# Default-deny provider capabilities. R4 may define an explicit remote endpoint
# allowlist; no candidate/JD data leaves the machine by default.
JOB_TRACKER_AGENT_NETWORK=disabled
JOB_TRACKER_LOG_LEVEL=info
