#!/usr/bin/env bash
# Job Search OS Universal CLI
# Can be run from ANY directory on your machine.

PROJECT_DIR="/Users/mouadatfi/Antigravity/job"
PYTHON="$PROJECT_DIR/.venv/bin/python"
export PYTHONPATH="$PROJECT_DIR"

if [ ! -f "$PYTHON" ]; then
  echo "Error: Virtual environment not found at $PYTHON"
  exit 1
fi

case "$1" in
  review)
    shift
    exec "$PYTHON" "$PROJECT_DIR/scripts/review_resume.py" "$@"
    ;;
  outcome)
    shift
    exec "$PYTHON" "$PROJECT_DIR/scripts/record_application_outcome.py" "$@"
    ;;
  scan|discovery)
    shift
    exec "$PYTHON" "$PROJECT_DIR/scripts/run_discovery.py" "$@"
    ;;
  tailor)
    shift
    exec "$PYTHON" "$PROJECT_DIR/scripts/tailor_resume.py" "$@"
    ;;
  profile)
    shift
    if [ "${1:-}" = "--confirm-replace" ]; then
      exec "$PYTHON" "$PROJECT_DIR/scripts/load_candidate_profile.py" "$@"
    fi
    exec "$PYTHON" "$PROJECT_DIR/scripts/show_candidate_profile.py" "$@"
    ;;
  status)
    shift
    exec "$PYTHON" "$PROJECT_DIR/scripts/show_pipeline_status.py" "$@"
    ;;
  *)
    echo "============================================================"
    echo "            JOB SEARCH OS - UNIVERSAL CLI                   "
    echo "============================================================"
    echo "Usage: job <command> [options]"
    echo ""
    echo "Commands:"
    echo "  job review   --job-id <ID>           Review and approve a tailored resume"
    echo "  job outcome  --app-id <ID>           Record human-confirmed submission"
    echo "  job tailor   --job-id <ID>           Generate tailored resume for a job"
    echo "  job scan     [--schedule <name>]     Run discovery scan (morning_scan/evening_scan)"
    echo "  job status                           Show pipeline job counts and metrics"
    echo "  job profile                          Show canonical candidate profile"
    echo "  job profile --confirm-replace        Reload canonical candidate profile"
    echo "============================================================"
    ;;
esac
