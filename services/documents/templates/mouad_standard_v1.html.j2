<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta http-equiv="Content-Security-Policy" content="default-src 'none'; style-src 'unsafe-inline'; font-src 'none'; img-src 'none';">
<style>
  @page {
    size: Letter 8.5in 11in;
    margin: 0.68in 0.74in 0.62in;
  }
  body {
    margin: 0;
    padding: 0;
    color: #292929;
    background: #ffffff;
    font-family: Arial, "Helvetica Neue", Helvetica, sans-serif;
    font-size: 10.35pt;
    line-height: 1.36;
  }
  .resume-header {
    margin-bottom: 17pt;
    text-align: center;
  }
  h1 {
    margin: 0 0 3pt;
    color: #213c6b;
    font-size: 20.5pt;
    line-height: 1.05;
    letter-spacing: 0.018em;
    text-transform: uppercase;
  }
  .contact-line {
    margin: 0;
    color: #595959;
    font-size: 9.65pt;
    line-height: 1.25;
  }
  .contact-line a {
    color: inherit;
    text-decoration: none;
  }
  .separator {
    padding: 0 0.32em;
    color: #737373;
  }
  section {
    margin: 0;
  }
  .section-title {
    margin: 14pt 0 7pt;
    padding: 0 0 3pt;
    border-bottom: 1.5pt solid #213c6b;
    color: #213c6b;
    font-size: 10.8pt;
    line-height: 1.1;
    letter-spacing: 0.015em;
    text-transform: uppercase;
    break-after: avoid;
    page-break-after: avoid;
  }
  .summary .section-title {
    margin-top: 0;
  }
  p {
    margin: 0;
  }
  .summary-copy {
    font-size: 10.35pt;
  }
  .job {
    margin: 0 0 9.5pt;
  }
  .job:last-child {
    margin-bottom: 0;
  }
  .job-header {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas:
      "company dates"
      "role location";
    column-gap: 18pt;
    align-items: baseline;
    margin-bottom: 2.5pt;
    break-after: avoid;
    page-break-after: avoid;
  }
  .company {
    grid-area: company;
    margin: 0;
    font-size: 10.35pt;
    line-height: 1.2;
    font-weight: 700;
  }
  .job-title {
    grid-area: role;
    font-style: italic;
    line-height: 1.25;
  }
  .dates,
  .location {
    color: #595959;
    line-height: 1.25;
    text-align: right;
    white-space: nowrap;
  }
  .dates {
    grid-area: dates;
  }
  .location {
    grid-area: location;
  }
  ul {
    margin: 0;
    padding: 0 0 0 15pt;
  }
  li {
    margin: 0 0 2.3pt;
    padding-left: 1.5pt;
    orphans: 2;
    widows: 2;
  }
  li:last-child {
    margin-bottom: 0;
  }
  .skills-list {
    display: grid;
    gap: 3.1pt;
  }
  .skill-label {
    font-weight: 700;
  }
  .education-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 18pt;
    align-items: baseline;
  }
  .school {
    font-weight: 700;
  }
</style>
</head>
<body>

<header class="resume-header">
  <h1>{{ header.full_name }}</h1>
  <p class="contact-line">{% for part in header.contact_parts %}{% if not loop.first %}<span class="separator" aria-hidden="true">|</span>{% endif %}{% if part.href %}<a href="{{ part.href }}">{{ part.text }}</a>{% else %}{{ part.text }}{% endif %}{% endfor %}</p>
</header>

{% if summary_copy %}
<section class="summary" aria-labelledby="summary-heading">
  <h2 class="section-title" id="summary-heading">Summary</h2>
  <p class="summary-copy">{{ summary_copy }}</p>
</section>
{% endif %}

{% if professional_experience %}
<section aria-labelledby="experience-heading">
  <h2 class="section-title" id="experience-heading">Professional Experience</h2>
  {% for job in professional_experience %}
  <article class="job">
    <header class="job-header">
      <h3 class="company">{{ job.company }}</h3>
      <div class="dates">{{ job.dates }}</div>
      <div class="job-title">{{ job.role }}</div>
      <div class="location">{{ job.location }}</div>
    </header>
    <ul>
      {% for bullet in job.bullets %}
      <li>{{ bullet }}</li>
      {% endfor %}
    </ul>
  </article>
  {% endfor %}
</section>
{% endif %}

{% if earlier_career %}
<section aria-labelledby="earlier-heading">
  <h2 class="section-title" id="earlier-heading">Earlier Career</h2>
  {% for job in earlier_career %}
  <article class="job">
    <header class="job-header">
      <h3 class="company">{{ job.company }}</h3>
      <div class="dates">{{ job.dates }}</div>
      <div class="job-title">{{ job.role }}</div>
      <div class="location">{{ job.location }}</div>
    </header>
    <ul>
      {% for bullet in job.bullets %}
      <li>{{ bullet }}</li>
      {% endfor %}
    </ul>
  </article>
  {% endfor %}
</section>
{% endif %}

{% if skill_rows %}
<section aria-labelledby="skills-heading">
  <h2 class="section-title" id="skills-heading">Skills</h2>
  <div class="skills-list">
    {% for row in skill_rows %}
    <p><span class="skill-label">{{ row.label }}:</span> {{ row.terms | join(', ') }}</p>
    {% endfor %}
  </div>
</section>
{% endif %}

{% if education_rows %}
<section aria-labelledby="education-heading">
  <h2 class="section-title" id="education-heading">Education</h2>
  {% for edu in education_rows %}
  <div class="education-row">
    <p><span class="school">{{ edu.school }}</span>{{ edu.detail }}</p>
    <p class="dates">{{ edu.dates }}</p>
  </div>
  {% endfor %}
</section>
{% endif %}

</body>
</html>
