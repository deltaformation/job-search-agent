{
  "name": "record_review_decision",
  "description": "\n    Record human review decision for a shortlisted job.\n    Decisions: 'reviewed', 'tailoring', 'skipped', 'deferred'.\n    If deferred, job will be suppressed until deferred_hours expire.\n    If skipped, job remains suppressed with audit skip_reason.\n    ",
  "parameters": {
    "properties": {
      "job_id": {
        "title": "Job Id",
        "type": "string"
      },
      "decision": {
        "title": "Decision",
        "type": "string"
      },
      "skip_reason": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Skip Reason"
      },
      "notes": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Notes"
      },
      "deferred_hours": {
        "anyOf": [
          {
            "type": "number"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Deferred Hours"
      }
    },
    "required": [
      "job_id",
      "decision"
    ],
    "title": "record_review_decisionArguments",
    "type": "object"
  }
}
