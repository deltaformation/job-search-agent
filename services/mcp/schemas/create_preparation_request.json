{
  "name": "create_preparation_request",
  "description": "\n    Idempotently create or retrieve a preparation request for job analysis and resume tailoring.\n    Enforces uniqueness on (job_id, idempotency_key). Retrying returns the existing request.\n    ",
  "parameters": {
    "properties": {
      "job_id": {
        "title": "Job Id",
        "type": "string"
      },
      "idempotency_key": {
        "title": "Idempotency Key",
        "type": "string"
      },
      "briefing_id": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Briefing Id"
      }
    },
    "required": [
      "job_id",
      "idempotency_key"
    ],
    "title": "create_preparation_requestArguments",
    "type": "object"
  }
}
