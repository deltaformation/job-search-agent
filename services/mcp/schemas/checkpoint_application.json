{
  "name": "checkpoint_application",
  "description": "\n    Persist a pre-submission review checkpoint and human checklist.\n    Halts autonomous execution before any submit/apply button or attestation.\n    Leaves browser open for human takeover.\n    ",
  "parameters": {
    "properties": {
      "application_id": {
        "title": "Application Id",
        "type": "string"
      },
      "attempt_id": {
        "title": "Attempt Id",
        "type": "string"
      },
      "stage": {
        "title": "Stage",
        "type": "string"
      },
      "page_url": {
        "title": "Page Url",
        "type": "string"
      },
      "blockers": {
        "items": {
          "type": "string"
        },
        "title": "Blockers",
        "type": "array"
      },
      "next_action": {
        "title": "Next Action",
        "type": "string"
      },
      "human_checklist": {
        "items": {
          "additionalProperties": true,
          "type": "object"
        },
        "title": "Human Checklist",
        "type": "array"
      },
      "idempotency_key": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Idempotency Key"
      },
      "snapshot_metadata": {
        "anyOf": [
          {
            "additionalProperties": true,
            "type": "object"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Snapshot Metadata"
      }
    },
    "required": [
      "application_id",
      "attempt_id",
      "stage",
      "page_url",
      "blockers",
      "next_action",
      "human_checklist"
    ],
    "title": "checkpoint_applicationArguments",
    "type": "object"
  }
}
